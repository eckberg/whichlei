// www.whichlei.com sends everyone to whichlei.com (DESIGN.md decision 28). A Worker of its own,
// not a route on whichlei-site: that Worker answers /lei/* only, and running it on every path
// would spend the free plan's 100,000 requests a day. www traffic is small.
// Deployed by .github/workflows/deploy-site.yml. The custom domain creates its own DNS record
// and certificate.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whichlei-redirect",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "routes": [{ "pattern": "www.whichlei.com", "custom_domain": true }],
  "vars": {
    // Where every request is sent, with its path and query.
    "TARGET_ORIGIN": "https://whichlei.com"
  }
}
